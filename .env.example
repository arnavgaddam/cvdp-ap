# Copy this file to .env for local runs. Do not commit .env.

# OpenRouter API settings. Copy this file to .env and fill these in locally.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used for both baseline and simulation-repair conditions. Pin this before
# running the full study so both conditions use the same model.
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_S=120

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=https://github.com/arnav/cvdp-ap
OPENROUTER_APP_NAME="CVDP RTL Harness Study"

# CVDP verifier image. Build this from the official CVDP repo:
# docker build -f docker/Dockerfile.sim -t nvidia/cvdp-sim:v1.0.0 .
CVDP_SIM_IMAGE=nvidia/cvdp-sim:v1.0.0

# Optional: local import convenience when running scripts directly.
PYTHONPATH=src
